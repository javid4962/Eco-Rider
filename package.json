{
  "name": "eco_ride",
  "version": "0.1.0",
  "private": true,
  "description": "Original EV-Only Mobility Platform for Andhra Pradesh",
  "scripts": {
    "build": "pnpm --filter api build && pnpm --filter ops-web build",
    "build:api": "pnpm --filter api build",
    "build:ops-web": "pnpm --filter ops-web build",
    "start": "pnpm --filter api start",
    "start:dev": "pnpm --filter api start:dev",
    "start:prod": "pnpm --filter api start:prod",
    "dev:ops-web": "pnpm --filter ops-web dev",
    "lint": "pnpm --filter api lint && pnpm --filter ops-web lint",
    "test": "pnpm --filter api test",
    "test:rider": "cd apps/rider_app && flutter test",
    "test:captain": "cd apps/captain_app && flutter test",
    "test:watch": "pnpm --filter api test:watch",
    "test:cov": "pnpm --filter api test:cov",
    "test:e2e": "pnpm --filter api test:e2e",
    "infra:up": "docker compose -f infrastructure/docker-compose.dev.yml up -d",
    "infra:down": "docker compose -f infrastructure/docker-compose.dev.yml down",
    "infra:status": "docker compose -f infrastructure/docker-compose.dev.yml ps",
    "infra:reset": "powershell -ExecutionPolicy Bypass -File ./infrastructure/manage-stack.ps1 -Action reset",
    "infra:verify": "powershell -ExecutionPolicy Bypass -File ./infrastructure/manage-stack.ps1 -Action verify",
    "openapi:export": "pnpm --filter api openapi:export",
    "flutter:generate": "node apps/api/node_modules/ts-node/dist/bin.js scripts/generate-flutter-client.ts",
    "migration:run": "pnpm --filter api migration:run",
    "migration:revert": "pnpm --filter api migration:revert",
    "seed": "pnpm --filter api seed",
    "seed:reset": "pnpm --filter api seed:reset"
  },
  "devDependencies": {
    "prettier": "^3.4.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}


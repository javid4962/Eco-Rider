# EcoRide Local Development Environment Variables
# Dev-only defaults for local docker compose setup. Never commit production credentials.

NODE_ENV=development
PORT=3000

# PostgreSQL + PostGIS (docker-compose dev service)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=ecoride_dev
DATABASE_PASSWORD=ecoride_dev_secret
DATABASE_NAME=ecoride_db
DATABASE_SSL=false

# Redis (docker-compose dev service)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Service info
SERVICE_NAME=ecoride-api

# OTP Provider Configuration (EV-018)
# Keep real sending off until approved. Defaults to synthetic MOCK provider for local dev.
OTP_PROVIDER_TYPE=MOCK

# Production MSG91 / TRAI DLT Configuration (Only used when OTP_PROVIDER_TYPE=MSG91)
# Safety Gate: Real sending stays hard-coded OFF until operational approval
MSG91_ENABLED=false
# Live / Test AuthKey must be injected securely via runtime secrets; never commit live keys.
MSG91_AUTH_KEY=
MSG91_SENDER_ID=ECORID
MSG91_BASE_URL=https://control.msg91.com/api/v5/otp
MSG91_TIMEOUT_MS=5000
MSG91_MAX_RETRIES=2
MSG91_DLT_PE_ID=1101550000000012345
MSG91_DLT_TE_ID_LOGIN=1107160000000010001
MSG91_DLT_TE_ID_RIDE_START=1107160000000010004
MSG91_DLT_TE_ID_EMERGENCY=1107160000000010007

# EcoRide Local Development Environment Variables
# Dev-only defaults for local docker compose setup. Never commit production credentials.

NODE_ENV=development
PORT=3000

# PostgreSQL + PostGIS (docker-compose dev service)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=ecoride_dev
DATABASE_PASSWORD=ecoride_dev_secret
DATABASE_NAME=ecoride_db
DATABASE_SSL=false

# Redis (docker-compose dev service)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Service info
SERVICE_NAME=ecoride-api


  "info": {
    "title": "EcoRide EV Mobility API",
    "description": "Authoritative OpenAPI 3.0 specification for EcoRide original EV-only mobility platform in Andhra Pradesh",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "Health",
      "description": "Platform health check and synthetic dependency probes"
    },
    {
      "name": "Release Boundaries",
      "description": "Gated release scopes, feature flags, and pilot zone permissions"
    },
    {
      "name": "Journeys",
      "description": "User state machine flows and role-based transitions"
    },
    {
      "name": "Design System",
      "description": "Original EV-only design tokens and bilingual UI parity"
    },
    {
      "name": "Test Matrix",
      "description": "Traceability matrix and release blocker governance"
    },
    {
      "name": "Quotes",
      "description": "Electric ride quoting with geofencing and integer paise calculation"
    }
  ],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "QuoteRequestDto": {
        "type": "object",
        "properties": {
          "city": {
            "type": "string",
            "description": "Target city in Andhra Pradesh for the EV ride quote",
            "example": "visakhapatnam",
            "enum": [
              "visakhapatnam",
              "vijayawada",
              "guntur",
              "tirupati"
            ]
          },
          "serviceCategory": {
            "type": "string",
            "description": "Service category (e.g. CITY_COMMUTE_2W, SHARED_SHUTTLE_4W)",
            "example": "CITY_COMMUTE_2W"
          },
          "pickupLatitude": {
            "type": "number",
            "description": "Pickup latitude within Andhra Pradesh",
            "example": 17.6868,
            "minimum": 12,
            "maximum": 20
          },
          "pickupLongitude": {
            "type": "number",
            "description": "Pickup longitude within Andhra Pradesh",
            "example": 83.2185,
            "minimum": 76,
            "maximum": 85
          },
          "dropoffLatitude": {
            "type": "number",
            "description": "Dropoff latitude within Andhra Pradesh",
            "example": 17.7275,
            "minimum": 12,
            "maximum": 20
          },
          "dropoffLongitude": {
            "type": "number",
            "description": "Dropoff longitude within Andhra Pradesh",
            "example": 83.3038,
            "minimum": 76,
            "maximum": 85
          }
        },
        "required": [
          "city",
          "serviceCategory",
          "pickupLatitude",
          "pickupLongitude",
          "dropoffLatitude",
          "dropoffLongitude"
        ]
      }
    }
  }
}
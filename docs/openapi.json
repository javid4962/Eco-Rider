    "/v1/quotes": {
      "post": {
        "operationId": "QuotesController_calculateQuote",
        "summary": "Calculate electric ride quote with geofencing and EV fare estimation",
        "description": "Computes spherical distance and integer paise fare for EV rides in Andhra Pradesh pilot cities.",
        "parameters": [
          {
            "name": "x-correlation-id",
            "in": "header",
            "description": "Optional client-supplied tracing correlation ID. Echoed back in response header and error envelopes.",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QuoteRequestDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Quote calculated successfully with integer paise fare and expiration timestamp"
          },
          "400": {
            "description": "Invalid coordinates, missing required parameters, or restricted pilot zone"
          }
        },
        "tags": [
          "Quotes"
        ]
      }
    },
    "/v1/seed/status": {
      "get": {
        "operationId": "SeedController_getStatus",
        "summary": "Check synthetic test data seed status",
        "description": "Returns counts of seeded synthetic users, BEVs, zones, bookings, and ledger entries.",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Seed status retrieved successfully"
          }
        },
        "tags": [
          "Development & Seed"
        ]
      }
    },
    "/v1/seed/run": {
      "post": {
        "operationId": "SeedController_runSeed",
        "summary": "Seed synthetic EV mobility data",
        "description": "Idempotently provisions fake AP cities, PostGIS zones, 100% BEVs, drivers, riders, and service flags.",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Synthetic dataset seeded successfully"
          }
        },
        "tags": [
          "Development & Seed"
        ]
      }
    },
    "/v1/seed/reset": {
      "post": {
        "operationId": "SeedController_resetSeed",
        "summary": "Reset and re-seed synthetic demo data",
        "description": "Cleans synthetic demo records and re-provisions a fresh deterministic dataset for demos and tests.",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Synthetic demo data reset and re-seeded successfully"
          }
        },
        "tags": [
          "Development & Seed"
        ]
      }
    }
